# Backend configuration (backend/app/config.py reads this)
# Paths default to the repo-level models/ directory, override if needed:
# MODEL_PATH=models/CS_model.keras
# TOKENIZER_PATH=models/tokenizer.pkl
# MAX_LEN=50
# CORS_ORIGINS=["http://localhost:3000"]
# Set to true to only analyze headlines matching cyber-security keywords:
# ENABLE_KEYWORD_FILTER=true

# Celery broker / result backend (Redis):
# REDIS_URL=redis://localhost:6379/0
# REDIS_RESULT_URL=redis://localhost:6379/1

# Frontend configuration (frontend/.env.local, or build arg when using Docker)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
